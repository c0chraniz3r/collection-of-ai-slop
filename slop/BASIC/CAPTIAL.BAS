10 REM CAPITALIST KINGDOM II - APPLESOFT BASIC
20 REM TURN-DRIVEN BUSINESS, PROPERTY AND STOCK TYCOON
30 REM APPLE II DOS 3.3 REQUIRED FOR DISK SAVE/LOAD
40 HOME:PRINT "CAPITALIST KINGDOM II"
50 PRINT "APPLE II APPLESOFT BASIC"
60 PRINT:PRINT "1 NEW EMPIRE":PRINT "2 LOAD EMPIRE"
70 INPUT "CHOICE";CH
80 DIM BN$(10),BC(10),BI(10),BA(10),UP(10),MG(10)
90 DIM PN$(20),PT(20),PP(20),RN(20),OW(20),HH(20),MO(20),CG(20)
100 DIM SN$(5),SP(5),SH(5),DV(5),HI(5)
110 DIM CN$(3),RC(3),CP(3),CS(3)
130 BN$(1)="LEMONADE":BC(1)=25:BI(1)=2
140 BN$(2)="NEWSPAPER":BC(2)=60:BI(2)=5
150 BN$(3)="CAR WASH":BC(3)=150:BI(3)=12
160 BN$(4)="PIZZA SHOP":BC(4)=350:BI(4)=28
170 BN$(5)="ARCADE":BC(5)=900:BI(5)=65
180 BN$(6)="SUPERMARKET":BC(6)=2500:BI(6)=160
190 BN$(7)="FACTORY":BC(7)=8000:BI(7)=450
200 BN$(8)="BANK":BC(8)=25000:BI(8)=1300
210 BN$(9)="TECH FIRM":BC(9)=80000:BI(9)=4000
220 BN$(10)="SPACE MINING":BC(10)=250000:BI(10)=14000
230 FOR I=1 TO 20:PT(I)=1:NEXT I
240 PN$(1)="GO":PT(1)=1
250 PN$(2)="OLD KENT RD":PP(2)=60:RN(2)=8:CG(2)=1
260 PN$(3)="COMMUNITY":PT(3)=2
270 PN$(4)="WHITECHAPEL":PP(4)=80:RN(4)=10:CG(4)=1
280 PN$(5)="INCOME TAX":PT(5)=3
290 PN$(6)="READING RAIL":PP(6)=200:RN(6)=25:PT(6)=4
300 PN$(7)="THE ANGEL":PP(7)=100:RN(7)=12:CG(7)=2
310 PN$(8)="CHANCE":PT(8)=2
320 PN$(9)="EUSTON RD":PP(9)=100:RN(9)=12:CG(9)=2
330 PN$(10)="WATER WORKS":PP(10)=150:RN(10)=20:PT(10)=5
340 PN$(11)="JAIL / VISIT":PT(11)=6
350 PN$(12)="PALL MALL":PP(12)=140:RN(12)=16:CG(12)=3
360 PN$(13)="ELECTRIC CO":PP(13)=150:RN(13)=20:PT(13)=5
370 PN$(14)="WHITEHALL":PP(14)=140:RN(14)=16:CG(14)=3
380 PN$(15)="NORTH RAIL":PP(15)=200:RN(15)=25:PT(15)=4
390 PN$(16)="CHANCE":PT(16)=2
400 PN$(17)="BOW STREET":PP(17)=180:RN(17)=20:CG(17)=4
410 PN$(18)="LUXURY TAX":PT(18)=3
420 PN$(19)="PARK PLACE":PP(19)=350:RN(19)=45:CG(19)=5
430 PN$(20)="BOARDWALK":PP(20)=400:RN(20)=55:CG(20)=5
440 SN$(1)="APPL PIE":SP(1)=20:DV(1)=1
450 SN$(2)="MOON TECH":SP(2)=45:DV(2)=2
460 SN$(3)="GOLD OIL":SP(3)=30:DV(3)=1
470 SN$(4)="RAIL CORP":SP(4)=25:DV(4)=1
480 SN$(5)="ROBOTICS":SP(5)=60:DV(5)=3
490 CN$(1)="RIVAL RED":CN$(2)="RIVAL BLUE":CN$(3)="RIVAL GOLD"
500 IF CH=2 THEN GOTO 6000
510 CA=100:TU=0:PO=1:LT=0:PR=0:NE=0:DE=0:BK=0:LO=0:IN=0
520 FOR I=1 TO 10:BA(I)=0:UP(I)=0:MG(I)=0:NEXT I
530 FOR I=1 TO 20:OW(I)=0:HH(I)=0:MO(I)=0:NEXT I
540 FOR I=1 TO 5:SH(I)=0:HI(I)=SP(I):NEXT I
550 FOR I=1 TO 3:RC(I)=100:CP(I)=1:CS(I)=0:NEXT I
560 GOTO 1000
1000 REM MAIN GAME TURN
1010 HOME:PRINT "CAPITALIST KINGDOM II"
1020 GOSUB 3000
1030 PRINT "DAY ";TU;" CASH $";INT(CA)
1040 PRINT "INCOME/TURN $";INT(IN);" NET WORTH $";INT(NE)
1050 PRINT "1 BUSINESSES  2 BOARD"
1060 PRINT "3 STOCKS      4 BANK"
1070 PRINT "5 REPORT      6 PRESTIGE"
1080 PRINT "7 SAVE        8 LOAD"
1090 PRINT "9 NEXT TURN   0 QUIT"
1100 INPUT "ACTION";AC
1110 IF AC=1 THEN GOTO 1500
1120 IF AC=2 THEN GOTO 2000
1130 IF AC=3 THEN GOTO 4000
1140 IF AC=4 THEN GOTO 4500
1150 IF AC=5 THEN GOTO 5000
1160 IF AC=6 THEN GOTO 5500
1170 IF AC=7 THEN GOTO 6500
1180 IF AC=8 THEN GOTO 6000
1190 IF AC=9 THEN GOTO 7000
1200 IF AC=0 THEN END
1210 GOTO 1000
1500 HOME:PRINT "BUSINESS EMPIRE"
1510 FOR I=1 TO 10
1520 PRINT I;" ";BN$(I);" OWN ";BA(I);" COST $";INT(BC(I)*(1.15^BA(I)))
1530 PRINT " INCOME $";INT(BI(I)*(1+UP(I))*(1+MG(I)*.25))
1540 NEXT I
1550 PRINT "11 UPGRADE  12 MANAGER  0 EXIT"
1560 INPUT "BUY BUSINESS NUMBER";CM
1570 IF CM=0 THEN GOTO 1000
1580 IF CM=11 THEN GOTO 1700
1590 IF CM=12 THEN GOTO 1800
1600 IF CM<1 OR CM>10 THEN GOTO 1500
1610 CO=BC(CM)*(1.15^BA(CM))
1620 IF CA<CO THEN PRINT "NOT ENOUGH CASH":GOTO 1500
1630 CA=CA-CO:BA(CM)=BA(CM)+1
1640 GOTO 1500
1700 INPUT "UPGRADE BUSINESS NUMBER";CM
1710 IF CM<1 OR CM>10 THEN GOTO 1500
1720 CO=BC(CM)*2*(UP(CM)+1)
1730 IF CA<CO THEN PRINT "NEED $";CO:GOTO 1500
1740 CA=CA-CO:UP(CM)=UP(CM)+1
1750 GOTO 1500
1800 INPUT "HIRE MANAGER FOR BUSINESS";CM
1810 IF CM<1 OR CM>10 THEN GOTO 1500
1820 CO=BC(CM)*5
1830 IF MG(CM)>0 THEN PRINT "MANAGER ALREADY HIRED":GOTO 1500
1840 IF CA<CO THEN PRINT "NEED $";CO:GOTO 1500
1850 CA=CA-CO:MG(CM)=1
1860 GOTO 1500
2000 HOME:PRINT "PROPERTY BOARD"
2010 PRINT "POSITION ";PO;" CASH $";INT(CA)
2020 FOR I=1 TO 20
2030 PRINT I;" ";PN$(I);
2040 IF PP(I)>0 THEN PRINT " $";PP(I);
2050 IF OW(I)>0 THEN PRINT " OWNED";
2060 IF HH(I)>0 THEN PRINT " H";HH(I);
2070 IF MO(I)=1 THEN PRINT " MORTGAGED";
2080 NEXT I
2090 PRINT "1 ROLL  2 BUY  3 BUILD"
2100 PRINT "4 MORTGAGE/REDEEM  0 EXIT"
2110 INPUT "CHOICE";CM
2120 IF CM=0 THEN GOTO 1000
2130 IF CM=1 THEN GOTO 2200
2140 IF CM=2 THEN GOTO 2300
2150 IF CM=3 THEN GOTO 2400
2160 IF CM=4 THEN GOTO 2500
2170 GOTO 2000
2200 D1=INT(RND(1)*6)+1:D2=INT(RND(1)*6)+1
2210 PRINT "ROLL ";D1;" + ";D2
2220 PO=PO+D1+D2
2230 IF PO>20 THEN PO=PO-20:CA=CA+200
2240 IF PT(PO)=2 THEN GOSUB 2700:GOTO 2000
2250 IF PT(PO)=3 THEN CA=CA-100:PRINT "TAX PAID $100":GOTO 2000
2260 IF PT(PO)=1 THEN GOTO 2000
2270 IF OW(PO)=1 THEN GOTO 2280
2275 PRINT "UNOWNED PROPERTY. USE BUY TO PURCHASE.":GOTO 2000
2280 IF MO(PO)=1 THEN PRINT "MORTGAGED: NO RENT":GOTO 2000
2282 RR=RN(PO)*(1+HH(PO)*.5)
2284 IF PT(PO)=4 THEN RR=RN(PO)*(D1+D2)
2286 IF CA<RR THEN RR=CA
2288 CA=CA-RR:LT=LT+RR:PRINT "RENT PAID $";RR
2290 GOTO 2000
2300 INPUT "PROPERTY NUMBER";CM
2310 IF CM<2 OR CM>20 THEN GOTO 2000
2320 IF PP(CM)=0 OR OW(CM)>0 THEN PRINT "NOT AVAILABLE":GOTO 2000
2330 IF CA<PP(CM) THEN PRINT "NOT ENOUGH CASH":GOTO 2000
2340 CA=CA-PP(CM):OW(CM)=1:PRINT "PROPERTY PURCHASED":GOTO 2000
2400 INPUT "PROPERTY NUMBER TO DEVELOP";CM
2410 IF CM<2 OR CM>20 THEN GOTO 2000
2420 IF OW(CM)=0 OR PT(CM)>1 THEN PRINT "MUST OWN A STREET":GOTO 2000
2430 IF HH(CM)>=5 THEN PRINT "HOTEL ALREADY BUILT":GOTO 2000
2440 CO=PP(CM)*.5*(HH(CM)+1)
2450 IF CA<CO THEN PRINT "NEED $";CO:GOTO 2000
2460 CA=CA-CO:HH(CM)=HH(CM)+1:PRINT "DEVELOPMENT ADDED":GOTO 2000
2500 INPUT "PROPERTY NUMBER";CM
2510 IF CM<2 OR CM>20 THEN GOTO 2000
2520 IF OW(CM)=0 THEN PRINT "NOT YOUR PROPERTY":GOTO 2000
2530 IF MO(CM)=0 THEN CA=CA+PP(CM)*.5:MO(CM)=1
2540 IF MO(CM)=1 AND CA>=PP(CM)*.55 THEN CA=CA-PP(CM)*.55:MO(CM)=0
2550 GOTO 2000
2700 IF INT(RND(1)*2)=0 THEN CA=CA+100:PRINT "CHANCE: BONUS $100"
2710 IF INT(RND(1)*2)=1 THEN CA=CA-50:PRINT "CHANCE: FEE $50"
2720 RETURN
3000 REM CALCULATE INCOME AND NET WORTH
3010 IN=0:NE=CA+BK-LO
3020 FOR I=1 TO 10
3030 IN=IN+BA(I)*BI(I)*(1+UP(I))*(1+MG(I)*.25)*(1+PR*.1)
3035 IF SH(I MOD 5+1)>=10 THEN IN=IN+DV(I MOD 5+1)*SH(I MOD 5+1)
3040 NE=NE+BA(I)*BC(I)*.5
3050 NEXT I
3060 FOR I=2 TO 20
3070 IF OW(I)=1 THEN NE=NE+PP(I)+HH(I)*PP(I)*.25-MO(I)*PP(I)*.5
3080 NEXT I
3090 FOR I=1 TO 5
3100 NE=NE+SH(I)*SP(I)
3110 NEXT I
3120 RETURN
4000 HOME:PRINT "STOCK EXCHANGE"
4010 PRINT "CASH $";INT(CA)
4020 FOR I=1 TO 5
4030 PRINT I;" ";SN$(I);" PRICE $";INT(SP(I));" SHARES ";SH(I)
4040 NEXT I
4050 PRINT "1 BUY  2 SELL  3 LEAVE"
4060 INPUT "CHOICE";CM
4070 IF CM=3 THEN GOTO 1000
4080 INPUT "COMPANY NUMBER";SC
4090 IF SC<1 OR SC>5 THEN GOTO 4000
4100 INPUT "NUMBER OF SHARES";SQ
4110 IF SQ<1 THEN GOTO 4000
4120 IF CM=1 THEN GOTO 4200
4130 IF SH(SC)<SQ THEN PRINT "NOT ENOUGH SHARES":GOTO 4000
4140 SH(SC)=SH(SC)-SQ:CA=CA+SQ*SP(SC):GOTO 4000
4200 IF CA<SQ*SP(SC) THEN PRINT "NOT ENOUGH CASH":GOTO 4000
4210 SH(SC)=SH(SC)+SQ:CA=CA-SQ*SP(SC):GOTO 4000
4500 HOME:PRINT "BANK"
4510 PRINT "CASH $";INT(CA);" DEPOSIT $";INT(BK);" LOAN $";INT(LO)
4520 PRINT "1 DEPOSIT  2 WITHDRAW  3 BORROW"
4530 PRINT "4 REPAY LOAN  0 EXIT"
4540 INPUT "CHOICE";CM
4550 IF CM=0 THEN GOTO 1000
4560 INPUT "AMOUNT";AM
4570 IF AM<0 THEN GOTO 4500
4580 IF CM=1 AND CA>=AM THEN CA=CA-AM:BK=BK+AM
4590 IF CM=2 AND BK>=AM THEN BK=BK-AM:CA=CA+AM
4600 IF CM=3 THEN LO=LO+AM:CA=CA+AM
4610 IF CM=4 AND CA>=AM AND LO>=AM THEN LO=LO-AM:CA=CA-AM
4620 GOTO 4500
5000 HOME:PRINT "EMPIRE REPORT"
5010 GOSUB 3000
5020 PRINT "DAY ";TU;" LIFETIME EARNINGS $";INT(LT)
5030 PRINT "CASH $";INT(CA);" DEPOSITS $";INT(BK)
5040 PRINT "DEBT $";INT(LO);" NET WORTH $";INT(NE)
5050 PRINT "INCOME/TURN $";INT(IN)
5060 PRINT "PROPERTIES:"
5070 FOR I=2 TO 20
5080 IF OW(I)=1 THEN PRINT PN$(I);" HOUSES/HOTEL ";HH(I)
5090 NEXT I
5100 PRINT "SHARE PORTFOLIO:"
5110 FOR I=1 TO 5
5120 PRINT SN$(I);" SHARES ";SH(I);" VALUE $";INT(SH(I)*SP(I))
5130 NEXT I
5140 PRINT "PRESS ANY KEY":GET A$:IF A$="" THEN 5140
5150 GOTO 1000
5500 HOME:PRINT "PRESTIGE / REBIRTH"
5510 PRINT "RESET EMPIRE FOR PERMANENT BONUS"
5520 PRINT "PRESTIGE POINTS ";PR
5530 PRINT "NET WORTH $";INT(NE)
5540 INPUT "REBIRTH? 1 YES 0 NO";CM
5550 IF CM<>1 OR NE<100000 THEN PRINT "NEED $100000 NET WORTH":GOTO 1000
5560 PR=PR+1:CA=100:TU=0:PO=1:BK=0:LO=0:LT=0
5570 FOR I=1 TO 10:BA(I)=0:UP(I)=0:MG(I)=0:NEXT I
5580 FOR I=2 TO 20:OW(I)=0:HH(I)=0:MO(I)=0:NEXT I
5590 FOR I=1 TO 5:SH(I)=0:NEXT I
5600 GOTO 1000
6000 REM LOAD GAME - APPLE DOS 3.3
6010 ONERR GOTO 6400
6020 PRINT CHR$(4);"OPEN KINGDOM"
6030 PRINT CHR$(4);"READ KINGDOM"
6040 INPUT TU,CA,PO,PR,LT,BK,LO
6050 FOR I=1 TO 10:INPUT BA(I),UP(I),MG(I):NEXT I
6060 FOR I=1 TO 20:INPUT OW(I),HH(I),MO(I):NEXT I
6070 FOR I=1 TO 5:INPUT SH(I),SP(I):NEXT I
6080 PRINT CHR$(4);"CLOSE KINGDOM"
6090 PRINT "GAME LOADED":GOTO 1000
6400 PRINT CHR$(4);"CLOSE KINGDOM"
6410 PRINT "LOAD FAILED - START NEW GAME"
6420 GOTO 510
6500 REM SAVE GAME - APPLE DOS 3.3
6510 PRINT CHR$(4);"OPEN KINGDOM"
6520 PRINT CHR$(4);"WRITE KINGDOM"
6530 PRINT TU:PRINT CA:PRINT PO:PRINT PR:PRINT LT:PRINT BK:PRINT LO
6540 FOR I=1 TO 10:PRINT BA(I):PRINT UP(I):PRINT MG(I):NEXT I
6550 FOR I=1 TO 20:PRINT OW(I):PRINT HH(I):PRINT MO(I):NEXT I
6560 FOR I=1 TO 5:PRINT SH(I):PRINT SP(I):NEXT I
6570 PRINT CHR$(4);"CLOSE KINGDOM"
6580 PRINT "GAME SAVED":GOTO 1000
7000 REM ADVANCE ONE TURN
7010 TU=TU+1
7020 GOSUB 3000
7030 CA=CA+IN:LT=LT+IN
7040 IF BK>0 THEN BK=BK*1.005
7045 IF LO>0 THEN LO=LO*1.02
7060 FOR I=1 TO 5
7070 CH=INT(RND(1)*11)-5
7080 SP(I)=SP(I)+CH
7090 IF SP(I)<1 THEN SP(I)=1
7110 IF SP(I)>HI(I) THEN HI(I)=SP(I)
7120 NEXT I
7130 FOR I=1 TO 5
7140 IF SH(I)>0 THEN CA=CA+SH(I)*DV(I)
7150 NEXT I
7160 IF INT(RND(1)*8)=0 THEN GOSUB 7300
7170 GOSUB 7500
7180 IF TU=1 THEN PRINT "ACHIEVEMENT: FIRST TURN +$25":CA=CA+25
7185 IF CA>=10000 AND DE=0 THEN PRINT "ACHIEVEMENT: $10,000 +$500":CA=CA+500:DE=1
7190 GOTO 1000
7300 REM RANDOM EVENT
7310 EV=INT(RND(1)*4)+1
7320 IF EV=1 THEN CA=CA+100:PRINT "EVENT: MARKET BOOM +$100"
7330 IF EV=2 THEN CA=CA-50:PRINT "EVENT: REPAIR BILL -$50"
7340 IF EV=3 THEN CA=CA+IN*.5:PRINT "EVENT: BUSINESS SURGE"
7350 IF EV=4 THEN CA=CA-CA*.05:PRINT "EVENT: TAX -5 PERCENT"
7360 RETURN
7500 REM RIVAL TYCOONS TAKE ACTION
7510 FOR I=1 TO 3
7520 RC(I)=RC(I)+INT(RND(1)*100)+20
7530 CP(I)=INT(RND(1)*19)+2
7540 IF OW(CP(I))=0 AND PP(CP(I))>0 AND RC(I)>=PP(CP(I)) THEN OW(CP(I))=I+1:RC(I)=RC(I)-PP(CP(I))
7550 NEXT I
7560 RETURN
8000 REM END OF PROGRAM
8010 END
